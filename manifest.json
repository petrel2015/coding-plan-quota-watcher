{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.8.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.volcengine.com/*",
    "https://*.minimaxi.com/*",
    "https://chatgpt.com/*",
    "https://codex-reset.com/*",
    "https://*.bigmodel.cn/*"
  ],
  "action": {
    "default_title": "__MSG_extTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "settings.html",
        "dist/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
